    <worksheet name="Mapa de vigencia">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontsize="13">% sin revisión vigente: criticidad × estado de gestión</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="dataset_calidad" name="federated.aitechcalidad" />
          </datasources>
          <datasource-dependencies datasource="federated.aitechcalidad">
            <column caption="Sin revisión vigente" datatype="integer" name="[Calculation_4]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IIF([revision_vigente] = 'No', 1, 0)" />
            </column>
            <column caption="% sin revisión vigente" datatype="real" name="[Calculation_6]" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="SUM([Calculation_4]) / COUNT([id_herramienta])" />
            </column>
            <column caption="Criticidad" datatype="string" name="[criticidad]" role="dimension" type="nominal" />
            <column caption="Estado de gestión" datatype="string" name="[estado_gestion]" role="dimension" type="nominal" />
            <column caption="Herramientas" datatype="integer" name="[id_herramienta]" role="measure" type="quantitative" />
            <column datatype="integer" name="[nivel_criticidad]" role="measure" type="quantitative" />
            <column caption="Revisión vigente" datatype="string" name="[revision_vigente]" role="dimension" type="nominal" />
            <column-instance column="[criticidad]" derivation="None" name="[none:criticidad:nk]" pivot="key" type="nominal" />
            <column-instance column="[estado_gestion]" derivation="None" name="[none:estado_gestion:nk]" pivot="key" type="nominal" />
            <column-instance column="[Calculation_6]" derivation="User" name="[usr:Calculation_6:qk]" pivot="key" type="quantitative" />
            <column-instance column="[nivel_criticidad]" derivation="Min" name="[min:nivel_criticidad:qk]" pivot="key" type="quantitative" />
