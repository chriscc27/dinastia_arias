    <worksheet name="NC por responsable">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontsize="13">Tasa de No conformidad por rol responsable</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="dataset_calidad" name="federated.aitechcalidad" />
          </datasources>
          <datasource-dependencies datasource="federated.aitechcalidad">
            <column caption="Es revisada" datatype="integer" name="[Calculation_1]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IIF([revisada] = 'Sí', 1, 0)" />
            </column>
            <column caption="Es no conforme" datatype="integer" name="[Calculation_3]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IIF([resultado_revision] = 'No conforme', 1, 0)" />
            </column>
            <column caption="Tasa NC" datatype="real" name="[Calculation_8]" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="SUM([Calculation_3]) / SUM([Calculation_1])" />
            </column>
            <column caption="Resultado de revisión" datatype="string" name="[resultado_revision]" role="dimension" type="nominal" />
            <column datatype="string" name="[revisada]" role="dimension" type="nominal" />
            <column caption="Rol responsable" datatype="string" name="[rol_responsable]" role="dimension" type="nominal" />
            <column-instance column="[rol_responsable]" derivation="None" name="[none:rol_responsable:nk]" pivot="key" type="nominal" />
            <column-instance column="[Calculation_8]" derivation="User" name="[usr:Calculation_8:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <sort class="computed" column="[federated.aitechcalidad].[none:rol_responsable:nk]" direction="DESC" using="[federated.aitechcalidad].[usr:Calculation_8:qk]" />
          <aggregation value="true" />
        </view>
        <style />
        <panes>
