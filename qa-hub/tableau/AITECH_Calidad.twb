            </column>
            <column caption="Herramienta" datatype="string" name="[herramienta_base]" role="dimension" type="nominal" />
            <column caption="Resultado de revisión" datatype="string" name="[resultado_revision]" role="dimension" type="nominal" />
            <column datatype="string" name="[revisada]" role="dimension" type="nominal" />
            <column-instance column="[herramienta_base]" derivation="None" name="[none:herramienta_base:nk]" pivot="key" type="nominal" />
