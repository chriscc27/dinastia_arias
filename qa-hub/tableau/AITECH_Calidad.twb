<?xml version='1.0' encoding='utf-8' ?>
<workbook xmlns:user="http://www.tableausoftware.com/xml/user" original-version="18.1" source-build="2025.1.0 (20251.25.0213.1408)" source-platform="win" version="18.1">
  <document-format-change-manifest />
  <preferences />
  <datasources>
    <datasource caption="dataset_calidad" inline="true" name="federated.aitechcalidad" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="dataset_calidad" name="textscan.aitechcsv">
            <connection class="textscan" directory="C:\Users\CHRIS\Documents\KEVIN\UNIVERSIDAD TAREAS\OCTAVO SEMESTRE\gerencia de TICS\dinastia_arias\qa-hub\data" filename="dataset_calidad.csv" password="" server="" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.aitechcsv" name="dataset_calidad.csv" table="[dataset_calidad#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="es_ES" separator=",">
            <column datatype="integer" name="id_herramienta" ordinal="0" />
            <column datatype="string" name="nombre_herramienta" ordinal="1" />
            <column datatype="string" name="herramienta_base" ordinal="2" />
            <column datatype="string" name="categoria_herramienta" ordinal="3" />
            <column datatype="string" name="categoria_esperada" ordinal="4" />
            <column datatype="string" name="categoria_consistente" ordinal="5" />
            <column datatype="string" name="responsable" ordinal="6" />
            <column datatype="string" name="rol_responsable" ordinal="7" />
            <column datatype="string" name="criticidad" ordinal="8" />
            <column datatype="integer" name="nivel_criticidad" ordinal="9" />
            <column datatype="string" name="estado_gestion" ordinal="10" />
            <column datatype="string" name="fecha_ultima_revision" ordinal="11" />
            <column datatype="string" name="resultado_revision" ordinal="12" />
            <column datatype="string" name="revisada" ordinal="13" />
            <column datatype="integer" name="dias_desde_revision" ordinal="14" />
            <column datatype="string" name="revision_vigente" ordinal="15" />
            <column datatype="integer" name="dias_creacion_a_revision" ordinal="16" />
            <column datatype="string" name="fecha_creacion" ordinal="17" />
            <column datatype="string" name="fecha_modificacion" ordinal="18" />
            <column datatype="integer" name="anio_creacion" ordinal="19" />
            <column datatype="string" name="trimestre_revision" ordinal="20" />
            <column datatype="string" name="riesgo_operativo" ordinal="21" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
      <column caption="Herramientas" datatype="integer" name="[id_herramienta]" role="measure" type="quantitative" />
      <column caption="Herramienta (instancia)" datatype="string" name="[nombre_herramienta]" role="dimension" type="nominal" />
      <column caption="Herramienta" datatype="string" name="[herramienta_base]" role="dimension" type="nominal" />
      <column caption="Categoría registrada" datatype="string" name="[categoria_herramienta]" role="dimension" type="nominal" />
      <column caption="Responsable" datatype="string" name="[responsable]" role="dimension" type="nominal" />
      <column caption="Rol responsable" datatype="string" name="[rol_responsable]" role="dimension" type="nominal" />
      <column caption="Criticidad" datatype="string" name="[criticidad]" role="dimension" type="nominal" />
      <column caption="Estado de gestión" datatype="string" name="[estado_gestion]" role="dimension" type="nominal" />
      <column caption="Última revisión" datatype="string" name="[fecha_ultima_revision]" role="dimension" type="nominal" />
      <column caption="Resultado de revisión" datatype="string" name="[resultado_revision]" role="dimension" type="nominal" />
      <column caption="Revisión vigente" datatype="string" name="[revision_vigente]" role="dimension" type="nominal" />
      <column caption="Días desde la revisión" datatype="integer" name="[dias_desde_revision]" role="measure" type="quantitative" />
      <column caption="Trimestre de revisión" datatype="string" name="[trimestre_revision]" role="dimension" type="nominal" />
      <column caption="Es revisada" datatype="integer" name="[Calculation_1]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IIF([revisada] = 'Sí', 1, 0)" />
      </column>
      <column caption="Es conforme" datatype="integer" name="[Calculation_2]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IIF([resultado_revision] = 'Conforme', 1, 0)" />
      </column>
      <column caption="Es no conforme" datatype="integer" name="[Calculation_3]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IIF([resultado_revision] = 'No conforme', 1, 0)" />
      </column>
      <column caption="Sin revisión vigente" datatype="integer" name="[Calculation_4]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IIF([revision_vigente] = 'No', 1, 0)" />
      </column>
      <column caption="Tasa de conformidad" datatype="real" name="[Calculation_5]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM([Calculation_2]) / SUM([Calculation_1])" />
      </column>
      <column caption="% sin revisión vigente" datatype="real" name="[Calculation_6]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM([Calculation_4]) / COUNT([id_herramienta])" />
      </column>
      <column caption="Riesgo crítico" datatype="boolean" name="[Calculation_7]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[estado_gestion] = 'En uso' AND [resultado_revision] = 'No conforme' AND [criticidad] = 'Crítica'" />
      </column>
      <column caption="Tasa NC" datatype="real" name="[Calculation_8]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM([Calculation_3]) / SUM([Calculation_1])" />
      </column>
      <column caption="Promedio NC del área (LOD)" datatype="real" name="[Calculation_9]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="{ FIXED : SUM([Calculation_3]) / SUM([Calculation_1]) }" />
      </column>
      <column caption="Posición vs promedio" datatype="string" name="[Calculation_10]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IIF([Calculation_8] &gt; MIN([Calculation_9]), 'Sobre el promedio', 'En o bajo el promedio')" />
      </column>
      <column caption="Es riesgo crítico" datatype="integer" name="[Calculation_11]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IIF([Calculation_7], 1, 0)" />
      </column>
      <column caption="Crítica nunca revisada" datatype="integer" name="[Calculation_12]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IIF([criticidad] = 'Crítica' AND [revisada] = 'No', 1, 0)" />
      </column>
      <column caption="% categoría correcta" datatype="real" name="[Calculation_13]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM(IIF([categoria_consistente] = 'Sí', 1, 0)) / COUNT([id_herramienta])" />
      </column>
      <column-instance column="[resultado_revision]" derivation="None" name="[none:resultado_revision:nk]" pivot="key" type="nominal" />
      <column-instance column="[Calculation_10]" derivation="User" name="[usr:Calculation_10:nk]" pivot="key" type="nominal" />
      <column-instance column="[revision_vigente]" derivation="None" name="[none:revision_vigente:nk]" pivot="key" type="nominal" />
      <extract count="-1" enabled="true" units="records">
        <connection access_mode="readonly" author-locale="es_ES" class="hyper" dbname="C:/Users/CHRIS/Documents/KEVIN/UNIVERSIDAD TAREAS/OCTAVO SEMESTRE/gerencia de TICS/dinastia_arias/qa-hub/tableau/dataset_calidad.hyper" default-settings="hyper" schema="Extract" sslmode="" tablename="Extract" update-time="10/31/2026 6:00:00 PM" username="tableau">
          <relation name="Extract" table="[Extract].[Extract]" type="table" />
        </connection>
      </extract>
      <layout dim-ordering="alphabetic" dim-percentage="0.5" measure-ordering="alphabetic" measure-percentage="0.4" show-structure="true" />
      <style>
        <style-rule element="mark">
          <encoding attr="color" field="[none:resultado_revision:nk]" type="palette">
            <map to="#0ca30c">
              <bucket>"Conforme"</bucket>
            </map>
            <map to="#fab219">
              <bucket>"Con observaciones"</bucket>
            </map>
            <map to="#d03b3b">
              <bucket>"No conforme"</bucket>
            </map>
            <map to="#bdbcb4">
              <bucket>"Sin revisión"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[usr:Calculation_10:nk]" type="palette">
            <map to="#d03b3b">
              <bucket>"Sobre el promedio"</bucket>
            </map>
            <map to="#445e5f">
              <bucket>"En o bajo el promedio"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[none:revision_vigente:nk]" type="palette">
            <map to="#0ca30c">
              <bucket>"Sí"</bucket>
            </map>
            <map to="#d03b3b">
              <bucket>"No"</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
    </datasource>
  </datasources>
