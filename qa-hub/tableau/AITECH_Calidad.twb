    <worksheet name="Revisiones por trimestre">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontsize="13">Revisiones por trimestre (verde: conforme · amarillo: con observaciones · rojo: no conforme)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="dataset_calidad" name="federated.aitechcalidad" />
          </datasources>
          <datasource-dependencies datasource="federated.aitechcalidad">
            <column caption="Herramientas" datatype="integer" name="[id_herramienta]" role="measure" type="quantitative" />
            <column caption="Resultado de revisión" datatype="string" name="[resultado_revision]" role="dimension" type="nominal" />
            <column caption="Trimestre de revisión" datatype="string" name="[trimestre_revision]" role="dimension" type="nominal" />
            <column-instance column="[id_herramienta]" derivation="Count" name="[cnt:id_herramienta:qk]" pivot="key" type="quantitative" />
            <column-instance column="[trimestre_revision]" derivation="None" name="[none:trimestre_revision:nk]" pivot="key" type="nominal" />
            <column-instance column="[resultado_revision]" derivation="None" name="[none:resultado_revision:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.aitechcalidad].[none:resultado_revision:nk]">
