    <worksheet name="Conformidad por trimestre">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontsize="13">Tasa de conformidad por trimestre de revisión</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="dataset_calidad" name="federated.aitechcalidad" />
          </datasources>
          <datasource-dependencies datasource="federated.aitechcalidad">
            <column caption="Es revisada" datatype="integer" name="[Calculation_1]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IIF([revisada] = 'Sí', 1, 0)" />
            </column>
            <column caption="Es conforme" datatype="integer" name="[Calculation_2]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IIF([resultado_revision] = 'Conforme', 1, 0)" />
            </column>
            <column caption="Tasa de conformidad" datatype="real" name="[Calculation_5]" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="SUM([Calculation_2]) / SUM([Calculation_1])" />
            </column>
            <column caption="Resultado de revisión" datatype="string" name="[resultado_revision]" role="dimension" type="nominal" />
            <column datatype="string" name="[revisada]" role="dimension" type="nominal" />
            <column caption="Trimestre de revisión" datatype="string" name="[trimestre_revision]" role="dimension" type="nominal" />
            <column-instance column="[Calculation_5]" derivation="User" name="[usr:Calculation_5:qk]" pivot="key" type="quantitative" />
            <column-instance column="[trimestre_revision]" derivation="None" name="[none:trimestre_revision:nk]" pivot="key" type="nominal" />
            <column-instance column="[resultado_revision]" derivation="None" name="[none:resultado_revision:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.aitechcalidad].[none:resultado_revision:nk]">
            <groupfilter function="except" user:ui-domain="database" user:ui-enumeration="exclusive" user:ui-marker="enumerate">
              <groupfilter function="level-members" level="[none:resultado_revision:nk]" />
              <groupfilter function="member" level="[none:resultado_revision:nk]" member="&quot;Sin revisión&quot;" />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.aitechcalidad].[none:resultado_revision:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <text column="[federated.aitechcalidad].[usr:Calculation_5:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
                <format attr="mark-labels-cull" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.aitechcalidad].[usr:Calculation_5:qk]</rows>
        <cols>[federated.aitechcalidad].[none:trimestre_revision:nk]</cols>
      </table>
    </worksheet>
    <worksheet name="Tabla de riesgo crítico">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontsize="13">Críticas en uso con revisión No conforme (acción inmediata)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="dataset_calidad" name="federated.aitechcalidad" />
