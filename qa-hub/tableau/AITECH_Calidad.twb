            <column caption="Riesgo crítico" datatype="boolean" name="[Calculation_7]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[estado_gestion] = 'En uso' AND [resultado_revision] = 'No conforme' AND [criticidad] = 'Crítica'" />
            </column>
            <column caption="Criticidad" datatype="string" name="[criticidad]" role="dimension" type="nominal" />
            <column caption="Días desde la revisión" datatype="integer" name="[dias_desde_revision]" role="measure" type="quantitative" />
            <column caption="Estado de gestión" datatype="string" name="[estado_gestion]" role="dimension" type="nominal" />
            <column caption="Última revisión" datatype="string" name="[fecha_ultima_revision]" role="dimension" type="nominal" />
            <column caption="Herramienta (instancia)" datatype="string" name="[nombre_herramienta]" role="dimension" type="nominal" />
            <column caption="Responsable" datatype="string" name="[responsable]" role="dimension" type="nominal" />
            <column caption="Resultado de revisión" datatype="string" name="[resultado_revision]" role="dimension" type="nominal" />
            <column-instance column="[nombre_herramienta]" derivation="None" name="[none:nombre_herramienta:nk]" pivot="key" type="nominal" />
            <column-instance column="[responsable]" derivation="None" name="[none:responsable:nk]" pivot="key" type="nominal" />
            <column-instance column="[fecha_ultima_revision]" derivation="None" name="[none:fecha_ultima_revision:nk]" pivot="key" type="nominal" />
            <column-instance column="[dias_desde_revision]" derivation="Min" name="[min:dias_desde_revision:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calculation_7]" derivation="None" name="[none:Calculation_7:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.aitechcalidad].[none:Calculation_7:nk]">
            <groupfilter function="union" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate">
              <groupfilter function="member" level="[none:Calculation_7:nk]" member="true" />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.aitechcalidad].[none:Calculation_7:nk]</column>
          </slices>
