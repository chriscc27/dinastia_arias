  <dashboards>
    <dashboard name="1 Resumen ejecutivo">
      <style />
      <size maxheight="700" maxwidth="1320" minheight="700" minwidth="1320" />
      <zones>
        <zone h="100000" id="3" type-v2="layout-basic" w="100000" x="0" y="0">
          <zone h="98000" id="4" param="vert" type-v2="layout-flow" w="98400" x="800" y="1000">
            <zone h="7000" id="5" type-v2="text" w="98400" x="800" y="1000">
              <formatted-text>
                <run bold="true" fontcolor="#222f30" fontsize="18">Resumen ejecutivo de conformidad — AITECH | Área de Calidad</run>
              </formatted-text>
            </zone>
            <zone h="27300" id="6" param="horz" type-v2="layout-flow" w="98400" x="800" y="8000">
              <zone h="27300" id="7" name="KPI Total" w="19680" x="800" y="8000">
                <zone-style>
                  <format attr="border-color" value="#e1e0d9" />
                  <format attr="border-style" value="solid" />
                  <format attr="border-width" value="1" />
                  <format attr="margin" value="4" />
                </zone-style>
              </zone>
              <zone h="27300" id="8" name="KPI Conformidad" w="19680" x="20480" y="8000">
                <zone-style>
                  <format attr="border-color" value="#e1e0d9" />
                  <format attr="border-style" value="solid" />
                  <format attr="border-width" value="1" />
                  <format attr="margin" value="4" />
                </zone-style>
              </zone>
              <zone h="27300" id="9" name="KPI Sin vigente" w="19680" x="40160" y="8000">
                <zone-style>
                  <format attr="border-color" value="#e1e0d9" />
                  <format attr="border-style" value="solid" />
                  <format attr="border-width" value="1" />
                  <format attr="margin" value="4" />
                </zone-style>
              </zone>
              <zone h="27300" id="10" name="KPI Críticas NC" w="19680" x="59840" y="8000">
                <zone-style>
                  <format attr="border-color" value="#e1e0d9" />
                  <format attr="border-style" value="solid" />
                  <format attr="border-width" value="1" />
                  <format attr="margin" value="4" />
                </zone-style>
              </zone>
              <zone h="27300" id="11" name="KPI Críticas sin revisión" w="19680" x="79520" y="8000">
                <zone-style>
                  <format attr="border-color" value="#e1e0d9" />
                  <format attr="border-style" value="solid" />
                  <format attr="border-width" value="1" />
                  <format attr="margin" value="4" />
                </zone-style>
              </zone>
            </zone>
